{
    "pluginAlias": "enphaseEnvoyMatter",
    "pluginType": "platform",
    "singular": true,
    "fixArrayDisplay": true,
    "customUi": false,
    "headerDisplay": "Publishes Enphase Envoy / IQ Gateway solar production and home consumption as **Matter electrical sensors**, so they appear in the Apple Home Energy view on iOS 27 and later.\n\nThis plugin registers no HomeKit accessories. It requires **Homebridge 2.4.0 or later** with **Matter enabled on this plugin's child bridge** (Bridge Settings -> enable Matter).\n\nIt installs alongside `homebridge-enphase-envoy` and does not replace it \u2014 the two use separate plugin names, platform blocks and child bridges.",
    "footerDisplay": "For documentation please see the [GitHub repository](https://github.com/jmarrmd/homebridge-enphase-envoy).",
    "schema": {
        "type": "object",
        "properties": {
            "devices": {
                "title": "Devices",
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "title": "Name",
                            "type": "string",
                            "default": "Envoy",
                            "required": true,
                            "description": "Name for this gateway. Used as the prefix for the published sensor names."
                        },
                        "host": {
                            "title": "Address",
                            "type": "string",
                            "default": "envoy.local",
                            "required": false,
                            "format": "hostname",
                            "description": "Hostname or IP address of the gateway. Defaults to envoy.local."
                        },
                        "envoyFirmware7xxTokenGenerationMode": {
                            "title": "Authentication",
                            "type": "integer",
                            "default": 0,
                            "required": true,
                            "oneOf": [
                                {
                                    "title": "None - firmware v5/v6",
                                    "enum": [
                                        0
                                    ]
                                },
                                {
                                    "title": "Enlighten credentials - firmware v7 and later",
                                    "enum": [
                                        1
                                    ]
                                },
                                {
                                    "title": "Own token - firmware v7 and later",
                                    "enum": [
                                        2
                                    ]
                                }
                            ],
                            "description": "Firmware v7 and later require a JWT. Generate it from your Enlighten credentials, or paste a token you generated yourself."
                        },
                        "enlightenUser": {
                            "title": "Enlighten user",
                            "type": "string",
                            "required": false,
                            "description": "Your Enlighten account email address.",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].envoyFirmware7xxTokenGenerationMode === 1;"
                            }
                        },
                        "enlightenPasswd": {
                            "title": "Enlighten password",
                            "type": "string",
                            "required": false,
                            "format": "password",
                            "description": "Your Enlighten account password.",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].envoyFirmware7xxTokenGenerationMode === 1;"
                            }
                        },
                        "envoyToken": {
                            "title": "Token",
                            "type": "string",
                            "required": false,
                            "description": "A JWT you generated yourself at entrez.enphaseenergy.com.",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].envoyFirmware7xxTokenGenerationMode === 2;"
                            }
                        },
                        "envoyPasswd": {
                            "title": "Envoy password",
                            "type": "string",
                            "required": false,
                            "format": "password",
                            "description": "Only needed on firmware v5/v6 if the gateway password is not the last six digits of its serial number.",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].envoyFirmware7xxTokenGenerationMode === 0;"
                            }
                        },
                        "productionEnabled": {
                            "title": "Publish solar production",
                            "type": "boolean",
                            "default": true,
                            "required": false,
                            "description": "Publish a Matter electrical sensor reporting PV production."
                        },
                        "productionName": {
                            "title": "Solar production name",
                            "type": "string",
                            "required": false,
                            "description": "Name of the production sensor. Defaults to \"<Name> Solar Production\".",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].productionEnabled !== false;"
                            }
                        },
                        "consumptionEnabled": {
                            "title": "Publish home consumption",
                            "type": "boolean",
                            "default": true,
                            "required": false,
                            "description": "Publish a Matter electrical sensor reporting total house load. Requires consumption CTs installed on the gateway."
                        },
                        "consumptionName": {
                            "title": "Home consumption name",
                            "type": "string",
                            "required": false,
                            "description": "Name of the consumption sensor. Defaults to \"<Name> Home Consumption\".",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].consumptionEnabled !== false;"
                            }
                        },
                        "gridEnabled": {
                            "title": "Publish grid flow",
                            "type": "boolean",
                            "default": true,
                            "required": false,
                            "description": "Publish a Matter electrical meter reporting what crosses the service entrance \u2014 imported from the utility and exported to it. Neither production nor house load answers this on its own, because solar consumed on site never touches the grid, so without this sensor a controller cannot work out grid use."
                        },
                        "gridName": {
                            "title": "Grid name",
                            "type": "string",
                            "required": false,
                            "description": "Name of the grid sensor. Defaults to \"<Name> Grid\".",
                            "condition": {
                                "functionBody": "return model.devices[arrayIndices].gridEnabled !== false;"
                            }
                        },
                        "energyDeviceTypes": {
                            "title": "Use Matter energy device types",
                            "type": "boolean",
                            "default": false,
                            "required": false,
                            "description": "Publishes production as SolarPower (0x17) and consumption as ElectricalMeter (0x0514) instead of a plain electrical sensor. ElectricalSensor (0x0510) is a *utility* class device type, which per the Matter spec is not meant to stand alone as a device \u2014 so a controller may not treat the sensors as separate devices and can add them together on the summary tile. Confirmed working on an iOS 27 beta (August 2026): production appears as its own device in Electricity Usage with its energy counted as exported. Homebridge does not expose these device types officially, so they are read from matter.js directly; falls back to a plain electrical sensor if unavailable. Replaces the earlier solarPowerDeviceType option, which still works."
                        },
                        "refreshInterval": {
                            "title": "Refresh interval (seconds)",
                            "type": "integer",
                            "default": 30,
                            "minimum": 5,
                            "maximum": 3600,
                            "required": false,
                            "description": "How often to read the gateway. Live power is pushed every poll; lifetime energy at most once a minute."
                        },
                        "log": {
                            "type": "object",
                            "properties": {
                                "success": {
                                    "title": "Log success",
                                    "type": "boolean",
                                    "default": true,
                                    "required": false
                                },
                                "info": {
                                    "title": "Log info",
                                    "type": "boolean",
                                    "default": true,
                                    "required": false
                                },
                                "warn": {
                                    "title": "Log warnings",
                                    "type": "boolean",
                                    "default": true,
                                    "required": false
                                },
                                "error": {
                                    "title": "Log errors",
                                    "type": "boolean",
                                    "default": true,
                                    "required": false
                                },
                                "debug": {
                                    "title": "Log debug",
                                    "type": "boolean",
                                    "default": false,
                                    "required": false
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "layout": [
        {
            "key": "devices",
            "type": "array",
            "orderable": false,
            "buttonText": "Add device",
            "items": [
                "devices[].name",
                "devices[].host",
                {
                    "key": "devices[]",
                    "title": "Authentication",
                    "expandable": true,
                    "expanded": false,
                    "items": [
                        "devices[].envoyFirmware7xxTokenGenerationMode",
                        "devices[].enlightenUser",
                        "devices[].enlightenPasswd",
                        "devices[].envoyToken",
                        "devices[].envoyPasswd"
                    ]
                },
                {
                    "key": "devices[]",
                    "title": "Sensors",
                    "expandable": true,
                    "expanded": false,
                    "items": [
                        "devices[].productionEnabled",
                        "devices[].productionName",
                        "devices[].consumptionEnabled",
                        "devices[].consumptionName",
                        "devices[].gridEnabled",
                        "devices[].gridName",
                        "devices[].energyDeviceTypes",
                        "devices[].refreshInterval"
                    ]
                },
                {
                    "key": "devices[]",
                    "title": "Log",
                    "expandable": true,
                    "expanded": false,
                    "items": [
                        "devices[].log.success",
                        "devices[].log.info",
                        "devices[].log.warn",
                        "devices[].log.error",
                        "devices[].log.debug"
                    ]
                }
            ]
        }
    ]
}
